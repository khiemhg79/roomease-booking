# Supabase Dashboard -> Connect -> Session pooler
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_LONG_BASE64_SECRET
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SPRING_PROFILES_ACTIVE=dev
FLYWAY_ENABLED=false

# Google Identity Services
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
