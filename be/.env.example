# Supabase Dashboard -> Connect -> Session pooler
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_LONG_BASE64_SECRET
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SPRING_PROFILES_ACTIVE=dev
FLYWAY_ENABLED=false

# Google Identity Services
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SePay / VietQR
# Secret phải giống chính xác Secret Key đã nhập khi tạo webhook HMAC-SHA256.
SEPAY_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_REAL_SECRET
SEPAY_BANK_CODE=TPBank
SEPAY_ACCOUNT_NUMBER=YOUR_TPBANK_ACCOUNT_NUMBER
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME_WITHOUT_ACCENTS
SEPAY_QR_TEMPLATE=compact
SEPAY_STORE_NAME=RoomEase

# Để trống nếu QR chuyển thẳng vào tài khoản chính và nội dung chỉ là mã booking.
# Nếu SePay yêu cầu VA nội dung của TPBank, ví dụ TKP001, đặt:
# SEPAY_MEMO_PREFIX=TKP001
SEPAY_MEMO_PREFIX=

SEPAY_MAX_TIMESTAMP_DRIFT_SECONDS=300