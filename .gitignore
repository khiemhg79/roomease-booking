# =========================================================
# ROOMEASE - GITIGNORE
# Backend Spring Boot + 3 Frontend Vite
# =========================================================


# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

.env
.env.*
*.env
*.env.*

**/.env
**/.env.*
**/*.env
**/*.env.*

# Cho phép đẩy file mẫu
!.env.example
!**/.env.example


# =========================================================
# BACKEND - MAVEN / SPRING BOOT
# =========================================================

be/target/
**/target/

*.class
*.jar
*.war
*.ear

# Log Spring Boot
be/logs/
logs/
*.log
*.log.*

# File runtime
*.pid
*.seed
*.pid.lock


# =========================================================
# QUAN TRỌNG: KHÔNG IGNORE MAVEN WRAPPER
# =========================================================

# Không thêm các dòng sau:
# be/.mvn/
# .mvn/
# mvnw
# mvnw.cmd

# Các file Maven Wrapper phải được đẩy lên Git:
# be/.mvn/wrapper/maven-wrapper.properties
# be/mvnw
# be/mvnw.cmd


